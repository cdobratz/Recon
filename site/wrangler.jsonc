{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tracelamp",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "tracelamp.dev", "custom_domain": true },
    { "pattern": "www.tracelamp.dev", "custom_domain": true }
  ]
}
